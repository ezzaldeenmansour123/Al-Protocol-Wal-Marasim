# Binary assets are generated/downloaded at CI build time and must never
# be committed (the GitHub push path used for this repo cannot carry
# binary files). See README.md ("الملفات الثنائية") and
# .github/workflows/build.yml for how each file is provided before
# `flutter build`:
#   - assets/fonts/*.ttf   downloaded from Google Fonts in CI
#   - assets/marasim.db    built from tools/seed/*.json in CI
#   - assets/logo.png      generated by tools/make_icon.py fallback_icon in CI
#   - assets/images/*.jpg  downloaded from Unsplash in CI (PIL fallback)
assets/fonts/*.ttf
assets/fonts/*.otf
assets/marasim.db
assets/marasim.db.sha256
assets/logo.png
assets/images/*.jpg
assets/images/*.jpeg
assets/images/*.png
# Local generative-model weights (downloaded at first setup, never inside
# the APK and never committed). No model is bundled yet (P6: the only
# provider is RetrievalOnlyProvider); these lines are preventive, so a
# future model download cannot leak into a push.
assets/models/
*.onnx
*.tflite
*.gguf
*.bin
*.pt
*.safetensors
# Release artefacts (the CI job renames the APK to Protocol_Ceremonial.apk
# at the repo root; build/ below covers the nested build output)
*.apk
*.aab
# Flutter build outputs
build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
# NOTE: android/ is intentionally NOT ignored here. CI regenerates it on
# every run with `flutter create`, but signing config / manifest edits may
# need to be committed later — that is a team decision still open (see
# docs/CI_RUNBOOK.md). Until it is decided, check `git status` before any
# push: a locally generated android/ must not be pushed accidentally.
# Python bytecode (created by local verification runs)
__pycache__/
*.pyc
# OS / editor artefacts
.DS_Store
